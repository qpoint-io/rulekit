										}
										case 18 {
											p = ((te))-1;
											host( "src/lexer.rl", 99 ) ${ token_kind = Lexer::OP_IN;       ${p += 1; _nbreak = 1;}$ }$ 
										}
										case 19 {
											p = ((te))-1;
											host( "src/lexer.rl", 102 ) ${ token_kind = Lexer::TOKEN_INT;    ${p += 1; _nbreak = 1;}$ }$ 
										}
										case 20 {
											p = ((te))-1;
											host( "src/lexer.rl", 103 ) ${ token_kind = Lexer::TOKEN_FLOAT;  ${p += 1; _nbreak = 1;}$ }$ 
										}
										case 21 {
											p = ((te))-1;
											host( "src/lexer.rl", 104 ) ${ token_kind = Lexer::TOKEN_BOOL;   ${p += 1; _nbreak = 1;}$ }$ 
										}
										case 22 {
											p = ((te))-1;
											host( "src/lexer.rl", 105 ) ${ token_kind = Lexer::TOKEN_STRING; ${p += 1; _nbreak = 1;}$ }$ 
										}
										case 23 {
											p = ((te))-1;
											host( "src/lexer.rl", 107 ) ${ token_kind = Lexer::TOKEN_IP;         ${p += 1; _nbreak = 1;}$ }$ 
										}
										case 25 {
											p = ((te))-1;
											host( "src/lexer.rl", 109 ) ${ token_kind = Lexer::TOKEN_HEX_STRING; ${p += 1; _nbreak = 1;}$ }$ 
										}
										case 26 {
											p = ((te))-1;
											host( "src/lexer.rl", 110 ) ${ token_kind = Lexer::TOKEN_REGEX;      ${p += 1; _nbreak = 1;}$ }$ 
										}
										case 27 {
											p = ((te))-1;
											host( "src/lexer.rl", 112 ) ${ token_kind = Lexer::TOKEN_FUNCTION; ${p += 1; _nbreak = 1;}$ }$ 
										}
										case 29 {
											p = ((te))-1;
											host( "src/lexer.rl", 118 ) ${
            token_kind = Lexer::TOKEN_ERROR;
            ${p += 1; _nbreak = 1;}$
        }$ 
										}
									}}$
							}$
							
							
						}
					}
					_nacts -= 1;
					_acts += 1;
				}
				
				if ( _nbreak == 1 )
					break _resume;
			}
			break _again;
		}
		if ( p == eof ) {
			if ( cs >= 95 )
				break _resume;
		}
		else {
			_acts = offset( _rule_lexer_actions, _rule_lexer_to_state_actions[cs] );
			_nacts = cast(uint)deref( _rule_lexer_actions, _acts );
			_acts += 1;
			while ( _nacts > 0 ) {
				switch ( deref( _rule_lexer_actions, _acts ) ) {
					case 0 {
							host( "NONE", 1 ) ${${ts = nil;}$}$
						
						
					}
				}
				_nacts -= 1;
				_acts += 1;
			}
			
			p += 1;
			continue _resume;
		}
		break _resume;
	}
}
host( "src/lexer.rl", 190 ) @{

        self.p   = p;
        self.cs  = cs;
        self.ts  = ts;
        self.te  = te;
        self.act = act;

        if token_kind == 0 {
            // Consumed whitespace/comments — try again.
            if p < pe {
                return self.yylex();
            }
            return Token {
                token_type: -1,
                token_value: vec![],
                loc: Loc::default(),
            };
        }

        let raw = if ts <= te && te <= data.len() {
            data[ts..te].to_vec()
        } else {
            vec![]
        };

        Token {
            token_type: token_kind,
            token_value: raw,
            loc: Loc { begin: ts, end: te },
        }
    }
