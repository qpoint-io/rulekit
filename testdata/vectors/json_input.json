        "src.$ip": "1.2.3.4",
        "dst.$cidr": "10.0.0.0/8",
        "payload.$hex": "474554",
        "name.$string": "api",
        "enabled.$bool": true,
        "max.$uint64": "18446744073709551615",
        "nested": {"count.$int64": "42"}
