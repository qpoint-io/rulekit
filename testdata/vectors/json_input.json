    {
      "name": "plain mode keeps typed objects as objects",
      "expr": "src",
      "input_mode": "plain",
      "input": {"src.$ip": "1.2.3.4", "src": {"$type": "ip", "value": "1.2.3.4"}},
      "expect": {
        "value": {
