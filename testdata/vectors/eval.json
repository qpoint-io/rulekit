{
  "input_mode": "annotated_keys",
  "cases": [
    {
      "name": "engine example: tags array matches",
      "expr": "\n\t\ttags == 'db-svc'\n\t\tOR domain matches /example\\.com$/ -- any domain or subdomain of example.com\n\t\tOR src.process.path matches |^/usr/bin/| -- patterns can be enclosed in |...| or /.../\n\t\tOR (process.uid != 0 AND tags contains 'internal-svc') \n\t\t/* connections to LAN addresses over privileged ports */\n\t\tOR (destination.port <= 1023 AND destination.ip == 192.168.0.0/16)\n\t",
      "input": {
        "tags": ["db-svc", "internal-vlan", "unprivileged-user"],
        "domain": "example.com",
        "process": {"uid": 1000, "path": "/usr/bin/some-other-process"},
        "port": 8080
      },
      "expect": {"value": true}
    },
    {
      "name": "engine example: LAN address over privileged port",
      "expr": "\n\t\ttags == 'db-svc'\n\t\tOR domain matches /example\\.com$/ -- any domain or subdomain of example.com\n\t\tOR src.process.path matches |^/usr/bin/| -- patterns can be enclosed in |...| or /.../\n\t\tOR (process.uid != 0 AND tags contains 'internal-svc') \n\t\t/* connections to LAN addresses over privileged ports */\n\t\tOR (destination.port <= 1023 AND destination.ip == 192.168.0.0/16)\n\t",
      "input": {"destination": {"ip.$ip": "192.168.2.37", "port": 22}},
      "expect": {"value": true}
    },
    {
      "name": "engine example: flat dotted keys are not nested paths",
      "expr": "\n\t\ttags == 'db-svc'\n\t\tOR domain matches /example\\.com$/ -- any domain or subdomain of example.com\n\t\tOR src.process.path matches |^/usr/bin/| -- patterns can be enclosed in |...| or /.../\n\t\tOR (process.uid != 0 AND tags contains 'internal-svc') \n\t\t/* connections to LAN addresses over privileged ports */\n\t\tOR (destination.port <= 1023 AND destination.ip == 192.168.0.0/16)\n\t",
      "input": {"destination.ip.$ip": "1.1.1.1", "destination.port": 22},
      "expect": {
        "value": null,
        "missing_fields": ["destination.ip", "destination.port", "domain", "process.uid", "src.process.path", "tags"]
      }
    },
    {
      "name": "engine example: src process path matches",
      "expr": "\n\t\ttags == 'db-svc'\n\t\tOR domain matches /example\\.com$/ -- any domain or subdomain of example.com\n\t\tOR src.process.path matches |^/usr/bin/| -- patterns can be enclosed in |...| or /.../\n\t\tOR (process.uid != 0 AND tags contains 'internal-svc') \n\t\t/* connections to LAN addresses over privileged ports */\n\t\tOR (destination.port <= 1023 AND destination.ip == 192.168.0.0/16)\n\t",
      "input": {"src": {"process": {"path": "/usr/bin/some-other-process"}}},
      "expect": {"value": true}
    },
    {
      "name": "engine example: no branch matches",
      "expr": "\n\t\ttags == 'db-svc'\n\t\tOR domain matches /example\\.com$/ -- any domain or subdomain of example.com\n\t\tOR src.process.path matches |^/usr/bin/| -- patterns can be enclosed in |...| or /.../\n\t\tOR (process.uid != 0 AND tags contains 'internal-svc') \n\t\t/* connections to LAN addresses over privileged ports */\n\t\tOR (destination.port <= 1023 AND destination.ip == 192.168.0.0/16)\n\t",
      "input": {"src": {"process": {"path": "/opt/go"}}},
      "expect": {
        "value": null,
        "missing_fields": ["destination.ip", "destination.port", "domain", "process.uid", "tags"]
      }
    },
