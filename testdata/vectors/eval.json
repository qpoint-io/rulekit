    {"name": "not in: binds like a comparison under and", "expr": "x not in [1] and y", "input": {"x": 2, "y": true}, "expect": {"value": true}},
    {"name": "matches on an array: any element matches", "expr": "tags matches /^d/", "input": {"tags": ["web", "db"]}, "expect": {"value": true}},
    {"name": "matches on an array: no element matches", "expr": "tags matches /^z/", "input": {"tags": ["web", "db"]}, "expect": {"value": false}},
    {"name": "and: returns the right value when the left is truthy", "expr": "a && b", "input": {"a": 1, "b": "x"}, "expect": {"value": "x"}},
    {"name": "and: returns the falsy right value", "expr": "a && b", "input": {"a": 1, "b": 0}, "expect": {"value": 0}},
    {"name": "and: returns the falsy left value", "expr": "a && b", "input": {"a": "", "b": "x"}, "expect": {"value": ""}},
    {"name": "or: returns the truthy left value", "expr": "a || b", "input": {"a": "x", "b": "y"}, "expect": {"value": "x"}},
    {"name": "or: returns the right value when the left is falsy", "expr": "a || b", "input": {"a": 0, "b": ""}, "expect": {"value": ""}},
    {"name": "or: defaults a missing field", "expr": "a || \"d\"", "input": {}, "expect": {"value": "d"}},
    {"name": "or: a falsy default leaves a missing field unknown", "expr": "a || 0", "input": {}, "expect": {"missing_fields": ["a"]}},
    {"name": "or: an empty array is falsy", "expr": "tags || \"none\"", "input": {"tags": []}, "expect": {"value": "none"}},
    {"name": "and: a non-empty array is truthy", "expr": "tags && \"has\"", "input": {"tags": ["a"]}, "expect": {"value": "has"}},
    {"name": "and/or: picks between two values", "expr": "admin && \"admin\" || \"user\"", "input": {"admin": false}, "expect": {"value": "user"}},
    {"name": "not not: converts a value to bool", "expr": "!!a", "input": {"a": "x"}, "expect": {"value": true}}
  ]
}
