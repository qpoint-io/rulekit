{
  "input_mode": "annotated_keys",
  "cases": [
    {
      "name": "or short-circuits the right side",
      "expr": "a == 1 or b == 2",
      "input": {"a": 1},
      "expect": {
        "value": true,
        "trace": {
          "kind": "binary",
          "expr": "a == 1 or b == 2",
          "status": "passed",
          "children": [
            {"status": "passed", "active": true, "pruned": false, "value": true},
            {"expr": "b == 2", "status": "pruned", "active": false, "pruned": true}
          ]
        }
      }
    },
    {
      "name": "missing fields propagate to the root",
      "expr": "a == 1 or b == 2",
      "input": {},
      "expect": {
        "missing_fields": ["a", "b"],
        "trace": {
          "status": "missing",
          "missing_fields": ["a", "b"],
          "children": [{"status": "missing"}, {"status": "missing"}]
        }
      }
    },
    {
      "name": "diagnostic: incomparable types",
      "expr": "port == \"443\"",
      "input": {"port": 443},
      "expect": {
        "value": false,
        "trace": {
          "status": "failed",
          "diagnostics": [
            {"code": "comparison_incomparable", "left_type": "int64", "operator": "eq", "right_type": "string"}
          ]
        }
      }
    },
    {
      "name": "diagnostic: unsupported operator",
      "expr": "port contains 443",
      "input": {"port": 443},
      "expect": {
        "value": false,
        "trace": {
          "status": "failed",
          "diagnostics": [
            {
              "code": "comparison_unsupported_operator",
              "left_type": "int64",
              "operator": "contains",
              "right_type": "int64"
            }
          ]
        }
      }
    },
    {
      "name": "diagnostic: invalid shape",
      "expr": "port contains [443]",
      "input": {"port": 443},
      "expect": {
        "value": false,
        "trace": {
          "status": "failed",
          "diagnostics": [
            {"code": "comparison_invalid_shape", "left_type": "int64", "operator": "contains", "right_type": "array"}
          ]
        }
      }
    },
    {
      "name": "diagnostic: in a value that is not a list",
      "expr": "x in allowed",
      "input": {"x": "b", "allowed": "abc"},
      "expect": {
        "value": false,
        "trace": {
          "status": "failed",
          "diagnostics": [
            {"code": "comparison_invalid_shape", "left_type": "string", "operator": "in", "right_type": "string"}
          ]
        }
      }
    },
    {
      "name": "macro call has the expanded macro as its child",
      "expr": "is_internal() and user != \"root\"",
      "input": {"ip.$ip": "172.16.0.1", "user": "api"},
      "macros": {"is_internal": "ip in 172.16.0.0/16 or host matches /svc\\.cluster\\.local$/"},
      "expect": {
        "value": true,
        "trace": {
          "status": "passed",
          "children": [
            {
              "expr": "is_internal()",
              "status": "passed",
              "children": [{"expr": "ip in 172.16.0.0/16 or host =~ /svc\\.cluster\\.local$/", "status": "passed"}]
            },
            {}
          ]
        }
      }
    },
    {
      "name": "negated operator traces its operands directly",
      "expr": "x not in [1, 2]",
      "input": {"x": 3},
      "expect": {
        "value": true,
        "trace": {"kind": "binary", "status": "passed", "children": [{"expr": "x"}, {"expr": "[1, 2]"}]}
      }
    },
    {
      "name": "and with one incomplete side keeps both operand traces",
      "expr": "x == 1 and a == 1",
      "input": {"a": 1},
      "expect": {
        "missing_fields": ["x"],
        "trace": {"status": "missing", "children": [{"expr": "x == 1", "status": "missing"}, {"expr": "a == 1", "status": "passed"}]}
      }
    },
    {
      "name": "or with one incomplete side keeps both operand traces",
      "expr": "x == 1 or a == 2",
      "input": {"a": 1},
      "expect": {
        "missing_fields": ["x"],
        "trace": {"status": "missing", "children": [{"expr": "x == 1", "status": "missing"}, {"expr": "a == 2", "status": "failed"}]}
      }
    },
    {
      "name": "array argument traces its items, pruning those after an incomplete one",
      "expr": "starts_with(s, [x, \"a\"])",
      "input": {"s": "abc"},
      "expect": {
        "missing_fields": ["x"],
        "trace": {
          "kind": "call",
          "status": "missing",
          "children": [
            {"expr": "s", "status": "passed"},
            {"expr": "[x, \"a\"]", "status": "missing", "children": [{"expr": "x", "status": "missing"}, {"expr": "\"a\"", "status": "pruned", "pruned": true}]}
          ]
        }
      }
    },
    {
      "name": "array comparison operand traces every item",
      "expr": "[x, 1] contains 1",
      "input": {},
      "expect": {
        "value": true,
        "trace": {
          "status": "passed",
          "missing_fields": [],
          "children": [
            {"expr": "[x, 1]", "status": "missing", "missing_fields": ["x"], "children": [{"expr": "x", "status": "missing"}, {"expr": "1", "status": "passed", "pruned": false}]},
            {"expr": "1", "status": "passed"}
          ]
        }
      }
    },
    {
      "name": "complete array traces its items",
      "expr": "x in [a, 1]",
      "input": {"a": 1, "x": 1},
      "expect": {
        "value": true,
        "trace": {"status": "passed", "children": [{"expr": "x"}, {"expr": "[a, 1]", "children": [{"expr": "a", "status": "passed"}, {"expr": "1", "status": "passed"}]}]}
      }
    },
    {
      "name": "call traces its arguments, pruning those after an incomplete one",
      "expr": "starts_with(y, \"a\")",
      "input": {},
      "expect": {
        "missing_fields": ["y"],
        "trace": {"kind": "call", "status": "missing", "children": [{"expr": "y", "status": "missing"}, {"expr": "\"a\"", "status": "pruned", "pruned": true}]}
      }
    },
    {
      "name": "complete call traces its arguments",
      "expr": "starts_with(s, \"a\")",
      "input": {"s": "abc"},
      "expect": {
        "value": true,
        "trace": {"kind": "call", "status": "passed", "children": [{"expr": "s", "status": "passed"}, {"expr": "\"a\"", "status": "passed"}]}
      }
    },
    {
      "name": "?? prunes the right side when the left is present",
      "expr": "a ?? \"d\"",
      "input": {"a": "x"},
      "expect": {
        "value": "x",
        "trace": {"kind": "binary", "expr": "a ?? \"d\"", "status": "passed", "children": [{"expr": "a", "status": "passed"}, {"expr": "\"d\"", "status": "pruned", "pruned": true, "active": false}]}
      }
    },
    {
      "name": "?? evaluates the right side when the left is missing",
      "expr": "a ?? \"d\"",
      "input": {},
      "expect": {
        "value": "d",
        "trace": {"kind": "binary", "status": "passed", "missing_fields": [], "children": [{"expr": "a", "status": "missing", "missing_fields": ["a"]}, {"expr": "\"d\"", "status": "passed"}]}
      }
    },
    {
      "name": "coalesce prunes the arguments after the chosen one",
      "expr": "coalesce(a, b, \"d\")",
      "input": {"b": 1},
      "expect": {
        "value": 1,
        "trace": {"kind": "call", "status": "passed", "children": [{"expr": "a", "status": "missing"}, {"expr": "b", "status": "passed"}, {"expr": "\"d\"", "status": "pruned", "pruned": true}]}
      }
    },
    {
      "name": "compact traces every element of a literal list",
      "expr": "compact([a, 1])",
      "input": {},
      "expect": {
        "value": [1],
        "trace": {"kind": "call", "status": "passed", "missing_fields": [], "children": [{"kind": "array", "status": "missing", "missing_fields": ["a"], "children": [{"expr": "a", "status": "missing"}, {"expr": "1", "status": "passed"}]}]}
      }
    },
    {
      "name": "in literal evaluates every element and passes on a present match",
      "expr": "\"x\" in [a, b]",
      "input": {"b": "x"},
      "expect": {
        "value": true,
        "trace": {"kind": "binary", "status": "passed", "missing_fields": [], "children": [{"expr": "\"x\"", "status": "passed"}, {"kind": "array", "status": "missing", "missing_fields": ["a"], "children": [{"expr": "a", "status": "missing"}, {"expr": "b", "status": "passed", "pruned": false}]}]}
      }
    },
    {
      "name": "in literal without a match is missing",
      "expr": "\"x\" in [a, b]",
      "input": {"b": "y"},
      "expect": {
        "missing_fields": ["a"],
        "trace": {"kind": "binary", "status": "missing", "missing_fields": ["a"], "children": [{"expr": "\"x\""}, {"kind": "array", "status": "missing", "children": [{"expr": "a", "status": "missing"}, {"expr": "b", "status": "passed"}]}]}
      }
    }
  ]
}
