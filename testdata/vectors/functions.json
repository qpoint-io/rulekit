{
  "input_mode": "annotated_keys",
  "cases": [
    {"name": "unknown function parses", "expr": "some_none_stdlib_fn()", "expect": {"parse_error": false}},
    {"name": "unknown function is an eval error", "expr": "unknown_fn()", "expect": {"error": true}},
    {"name": "unknown function with args is an eval error", "expr": "unknown_fn(some_args)", "expect": {"error": true}},
    {
      "name": "starts_with: match",
      "expr": "starts_with(url, \"https://\")",
      "input": {"url": "https://example.com"},
      "expect": {"value": true}
    },
    {
      "name": "starts_with: no match",
      "expr": "starts_with(url, \"https://\")",
      "input": {"url": "http://example.com"},
      "expect": {"value": false}
    },
    {
      "name": "starts_with: not a url",
      "expr": "starts_with(url, \"https://\")",
      "input": {"url": "invalid-url"},
      "expect": {"value": false}
    },
    {
      "name": "starts_with: ip stringified",
      "expr": "starts_with(ip, \"10.0\")",
      "input": {"ip.$ip": "10.0.0.1"},
      "expect": {"value": true}
    },
    {
      "name": "starts_with: int value is an error",
      "expr": "starts_with(code, \"5\")",
      "input": {"code": 500},
      "expect": {"error": true}
    },
    {
      "name": "starts_with: int prefix is an error",
      "expr": "starts_with(code, 5)",
      "input": {"code": "500"},
      "expect": {"error": true}
    },
    {
      "name": "starts_with: bool value is an error",
      "expr": "starts_with(starts_with(\"https://example.com\", \"https://\"), \"true\")",
      "expect": {"error": true}
    },
    {
      "name": "starts_with: url input uses its text",
      "expr": "starts_with(u, \"https://x.com/\")",
      "input": {"u.$url": "https://x.com/a"},
      "expect": {"value": true}
    },
    {
      "name": "starts_with: no args is a parse error",
      "expr": "starts_with()",
      "expect": {"parse_error": {"line": 1, "column": 14}}
    },
    {
      "name": "starts_with: one arg is a parse error",
      "expr": "starts_with(arg1)",
      "expect": {"parse_error": {"line": 1, "column": 18}}
    },
    {
      "name": "starts_with list: first prefix matches",
      "expr": "starts_with(type, [\"process.\", \"agent.\", \"installation.\"])",
      "input": {"type": "process.start"},
      "expect": {"value": true}
    },
    {
      "name": "starts_with list: later prefix matches",
      "expr": "starts_with(type, [\"process.\", \"agent.\", \"installation.\"])",
      "input": {"type": "installation.complete"},
      "expect": {"value": true}
    },
    {
      "name": "starts_with list: no prefix matches",
      "expr": "starts_with(type, [\"process.\", \"agent.\", \"installation.\"])",
      "input": {"type": "file.open"},
      "expect": {"value": false}
    },
    {
      "name": "starts_with list: an empty list literal is a parse error",
      "expr": "starts_with(type, [])",
      "expect": {"parse_error": {"line": 1, "column": 20}}
    },
    {
      "name": "starts_with list: int item is an error",
      "expr": "starts_with(type, [\"agent.\", 5])",
      "input": {"type": "process.start"},
      "expect": {"error": true}
    },
    {
      "name": "starts_with list: items after the first match are not checked",
      "expr": "starts_with(type, [\"process.\", 5])",
      "input": {"type": "process.start"},
      "expect": {"value": true}
    },
    {
      "name": "starts_with list: nested list item from input is an error",
      "expr": "starts_with(type, prefixes)",
      "input": {"type": "process.start", "prefixes": [["process."]]},
      "expect": {"error": true}
    },
    {
      "name": "starts_with list: list from input",
      "expr": "starts_with(type, prefixes)",
      "input": {"type": "agent.ready", "prefixes": ["process.", "agent."]},
      "expect": {"value": true}
    },
    {
      "name": "starts_with list: empty list from input does not match",
      "expr": "starts_with(type, prefixes)",
      "input": {"type": "agent.ready", "prefixes": []},
      "expect": {"value": false}
    },
    {
      "name": "starts_with list: int item from input is an error",
      "expr": "starts_with(type, prefixes)",
      "input": {"type": "agent.ready", "prefixes": [1, "agent."]},
      "expect": {"error": true}
    },
    {
      "name": "starts_with list: url value uses its text",
      "expr": "starts_with(u, [\"http://\", \"https://x.com/\"])",
      "input": {"u.$url": "https://x.com/a"},
      "expect": {"value": true}
    },
    {
      "name": "starts_with list: ip items use their text",
      "expr": "starts_with(addr, [192.168.1.1, 10.0.0.1])",
      "input": {"addr": "10.0.0.1:443"},
      "expect": {"value": true}
    },
    {
      "name": "starts_with list: ip items from input use their text",
      "expr": "starts_with(addr, prefixes)",
      "input_mode": "typed_document",
      "input": {
        "addr": {"$type": "string", "value": "10.0.0.1:443"},
        "prefixes": {"$type": "array", "value": [{"$type": "ip", "value": "192.168.1.1"}, {"$type": "ip", "value": "10.0.0.1"}]}
      },
      "expect": {"value": true}
    },
    {
      "name": "starts_with list: missing value is unknown",
      "expr": "starts_with(type, [\"process.\", \"agent.\"])",
      "input": {},
      "expect": {"value": null, "missing_fields": ["type"]}
    },
    {
      "name": "starts_with list: int value is an error",
      "expr": "starts_with(code, [\"5\"])",
      "input": {"code": 500},
      "expect": {"error": true}
    },
    {"name": "starts_with list: a missing prefix element is still strict", "expr": "starts_with(s, [a, \"x\"])", "input": {"s": "xy"}, "expect": {"value": null, "missing_fields": ["a"]}},
    {"name": "compact: drops a missing element", "expr": "compact([a, 123])", "input": {}, "expect": {"value": [123]}},
    {"name": "compact: every element missing is an empty list", "expr": "compact([a])", "input": {}, "expect": {"value": []}},
    {"name": "compact: drops null, keeps false", "expr": "compact([a, b])", "input": {"a": false, "b": null}, "expect": {"value": [false]}},
    {"name": "compact: keeps falsy values", "expr": "compact([a, b, c, d])", "input": {"a": 0, "b": "", "c": false, "d": []}, "expect": {"value": [0, "", false, []]}},
    {"name": "compact: keeps element order", "expr": "compact([a, b, c])", "input": {"a": 1, "c": 3}, "expect": {"value": [1, 3]}},
    {"name": "compact: parenthesized literal", "expr": "compact(([a, 1]))", "input": {}, "expect": {"value": [1]}},
    {"name": "compact: a missing argument is unknown", "expr": "compact(list)", "input": {}, "expect": {"value": null, "missing_fields": ["list"]}},
    {"name": "compact: an input list loses its nulls", "expr": "compact(list)", "input": {"list": [1, null, 2]}, "expect": {"value": [1, 2]}},
    {"name": "compact: a non-array argument is an error", "expr": "compact(s)", "input": {"s": "x"}, "expect": {"error": true}},
    {"name": "compact: a null argument is an error", "expr": "compact(s)", "input": {"s": null}, "expect": {"error": true}},
    {"name": "compact: an element error is the result", "expr": "compact([a, starts_with(code, \"5\")])", "input": {"code": 500}, "expect": {"error": true}},
    {"name": "compact: drops missing nested paths", "expr": "compact([a.x, b.y, c.z]) == \"v\"", "input": {"a": {"x": "v"}}, "expect": {"value": true}},
    {"name": "compact: no arguments is a parse error", "expr": "compact()", "expect": {"parse_error": true}},
    {"name": "compact: two arguments is a parse error", "expr": "compact([a], [b])", "expect": {"parse_error": true}},
    {"name": "coalesce: the first present argument", "expr": "coalesce(a, b, \"d\")", "input": {"b": "x"}, "expect": {"value": "x"}},
    {"name": "coalesce: the last argument when the rest are missing", "expr": "coalesce(a, b, \"d\")", "input": {}, "expect": {"value": "d"}},
    {"name": "coalesce: skips nulls", "expr": "coalesce(a, b)", "input": {"a": null, "b": 1}, "expect": {"value": 1}},
    {"name": "coalesce: falsy values are present", "expr": "coalesce(a, \"d\")", "input": {"a": 0}, "expect": {"value": 0}},
    {"name": "coalesce: every argument null is null", "expr": "coalesce(a, b)", "input": {"a": null, "b": null}, "expect": {"value": null}},
    {"name": "coalesce: every argument missing reports the last", "expr": "coalesce(a, b)", "input": {}, "expect": {"value": null, "missing_fields": ["b"]}},
    {"name": "coalesce: one argument", "expr": "coalesce(a)", "input": {"a": 1}, "expect": {"value": 1}},
    {"name": "coalesce: one missing argument is unknown", "expr": "coalesce(a)", "input": {}, "expect": {"value": null, "missing_fields": ["a"]}},
    {"name": "coalesce: an error stops the search", "expr": "coalesce(a, starts_with(code, \"5\"), \"d\")", "input": {"code": 500}, "expect": {"error": true}},
    {"name": "coalesce: no arguments is a parse error", "expr": "coalesce()", "expect": {"parse_error": true}}
  ]
}
