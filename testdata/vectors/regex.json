    {
      "name": "slash and pipe regex delimiters parse",
      "expr": "f_string matches /gl=se$/ and str matches |some/path/here|",
      "expect": {"parse_error": false}
    },
    {"name": "flag i", "expr": "ua matches /curl/i", "input": {"ua": "CURL/8.0"}, "expect": {"value": true}},
    {
      "name": "flag i with pipe delimiters",
      "expr": "ua matches |curl|i",
      "input": {"ua": "CURL/8.0"},
      "expect": {"value": true}
    },
    {
      "name": "case-sensitive by default",
      "expr": "ua matches /curl/",
      "input": {"ua": "CURL/8.0"},
      "expect": {"value": false}
    },
    {"name": "flag s", "expr": "body matches /a.b/s", "input": {"body": "a\nb"}, "expect": {"value": true}},
    {"name": "flag m", "expr": "body matches /^b$/m", "input": {"body": "a\nb"}, "expect": {"value": true}},
    {"name": "flags ims", "expr": "body matches /^A.B$/ims", "input": {"body": "x\na\nb"}, "expect": {"value": true}},
    {"name": "unknown flag is a parse error", "expr": "ua matches /curl/q", "expect": {"parse_error": true}},
    {
      "name": "keyword after closing delimiter",
      "expr": "ua matches /curl/and ok",
      "input": {"ua": "curl", "ok": true},
      "expect": {"value": true}
